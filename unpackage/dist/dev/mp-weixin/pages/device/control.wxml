view><view data-event-opts="{{[['tap',[['tvAction',['channelDown']]]]]}}" class="remote-btn data-v-157d195d" bindtap="__e"><text class="remote-icon data-v-157d195d">CH−</text></view><view data-event-opts="{{[['tap',[['tvAction',['mute']]]]]}}" class="remote-btn data-v-157d195d" bindtap="__e"><text class="remote-icon data-v-157d195d">🔇</text></view></view></view></block><block wx:if="{{device.type==='speaker'}}"><view class="control-section data-v-157d195d"><text class="section-title data-v-157d195d">音箱控制</text><view class="brightness-card data-v-157d195d"><text class="label data-v-157d195d">音量</text><slider class="slider data-v-157d195d" value="{{speakerState.volume}}" min="{{0}}" max="{{100}}" step="{{1}}" activeColor="#8B4513" backgroundColor="#D2B48C" block-size="24" data-event-opts="{{[['change',[['onVolumeChange',['$event']]]]]}}" bindchange="__e"></slider><text class="value data-v-157d195d">{{speakerState.volume+"%"}}</text></view><view class="quick-btns data-v-157d195d"><view data-event-opts="{{[['tap',[['speakerAction',['play']]]]]}}" class="quick-btn data-v-157d195d" bindtap="__e"><text class="quick-text data-v-157d195d">播放</text></view><view data-event-opts="{{[['tap',[['speakerAction',['pause']]]]]}}" class="quick-btn data-v-157d195d" bindtap="__e"><text class="quick-text data-v-157d195d">暂停</text></view><view data-event-opts="{{[['tap',[['speakerAction',['next']]]]]}}" class="quick-btn data-v-157d195d" bindtap="__e"><text class="quick-text data-v-157d195d">下一首</text></view></view></view></block><block wx:if="{{!isSpecialType}}"><view class="control-section data-v-157d195d"><text class="section-title data-v-157d195d">设备控制</text><view class="generic-control data-v-157d195d"><view class="quick-btns data-v-157d195d"><view data-event-opts="{{[['tap',[['genericAction',['on']]]]]}}" class="quick-btn data-v-157d195d" bindtap="__e"><text class="quick-text data-v-157d195d">开启</text></view><view data-event-opts="{{[['tap',[['genericAction',['off']]]]]}}" class="quick-btn data-v-157d195d" bindtap="__e"><text class="quick-text data-v-157d195d">关闭</text></view><view data-event-opts="{{[['tap',[['genericAction',['reset']]]]]}}" class="quick-btn data-v-157d195d" bindtap="__e"><text class="quick-text data-v-157d195d">重置</text></view></view></view></view></block><view class="timer-section data-v-157d195d"><text class="section-title data-v-157d195d">定时设置</text><view class="timer-card data-v-157d195d"><view class="timer-row data-v-157d195d"><text class="timer-label data-v-157d195d">开启定时</text><switch checked="{{timerEnabled}}" color="#8B4513" data-event-opts="{{[['change',[['e5',['$event']]]]]}}" bindchange="__e" class="data-v-157d195d"></switch></view><block wx:if="{{timerEnabled}}"><view class="timer-row data-v-157d195d"><text class="timer-label data-v-157d195d">定时时间</text><picker mode="time" data-event-opts="{{[['change',[['onTimeChange',['$event']]]]]}}" bindchange="__e" class="data-v-157d195d"><view class="time-picker data-v-157d195d"><text class="time-text data-v-157d195d">{{timerTime}}</text><text class="time-arrow data-v-157d195d">▼</text></view></picker></view></block></view></view><view class="action-btns data-v-157d195d"><view data-event-opts="{{[['tap',[['deleteDevice',['$event']]]]]}}" class="action-btn danger data-v-157d195d" bindtap="__e"><text class="action-icon data-v-157d195d">🗑️</text><text class="action-text data-v-157d195d">删除设备</text></view></view></view></block><block wx:else><view class="empty-state data-v-157d195d"><text class="empty-icon data-v-157d195d">📱</text><text class="empty-text data-v-157d195d">设备不存在</text></view></block></view>