<view class="add-device-container data-v-4e0c1ea1"><view class="nav-bar data-v-4e0c1ea1"><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="back-btn data-v-4e0c1ea1" bindtap="__e"><text class="back-icon data-v-4e0c1ea1">←</text></view><text class="nav-title data-v-4e0c1ea1">添加设备</text></view><view class="content data-v-4e0c1ea1"><view class="brand-section data-v-4e0c1ea1"><text class="section-title data-v-4e0c1ea1">选择设备品牌</text><view class="brand-grid data-v-4e0c1ea1"><block wx:for="{{brands}}" wx:for-item="brand" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['onSelectBrand',['$0'],[[['brands','id',brand.id]]]]]]]}}" class="{{['brand-card','data-v-4e0c1ea1',(selectedBrand===brand.id)?'active':'']}}" bindtap="__e"><text class="brand-icon data-v-4e0c1ea1">{{brand.icon}}</text><text class="brand-name data-v-4e0c1ea1">{{brand.name}}</text></view></block></view></view><view class="type-section data-v-4e0c1ea1"><text class="section-title data-v-4e0c1ea1">选择设备类型</text><view class="type-grid data-v-4e0c1ea1"><block wx:for="{{deviceTypes}}" wx:for-item="type" wx:for-index="__i1__" wx:key="id"><view data-event-opts="{{[['tap',[['onSelectType',['$0'],[[['deviceTypes','id',type.id]]]]]]]}}" class="{{['type-card','data-v-4e0c1ea1',(selectedType===type.id)?'active':'']}}" bindtap="__e"><text class="type-icon data-v-4e0c1ea1">{{type.icon}}</text><text class="type-name data-v-4e0c1ea1">{{type.name}}</text></view></block></view></view><view class="info-section data-v-4e0c1ea1"><text class="section-title data-v-4e0c1ea1">设备信息</text><view class="form-card data-v-4e0c1ea1"><view class="input-group data-v-4e0c1ea1"><text class="input-label data-v-4e0c1ea1">设备名称</text><input class="input-field data-v-4e0c1ea1" placeholder="为设备取个雅致的名字" placeholder-style="color: #D2B48C" data-event-opts="{{[['input',[['__set_model',['','deviceName','$event',[]]]]]]}}" value="{{deviceName}}" bindinput="__e"/></view><view class="input-group data-v-4e0c1ea1"><text clas