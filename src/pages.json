{
  "pages": [
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom",
        "disableScroll": true
      }
    },
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "首页",
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark",
        "backgroundColor": "#FFFAF0"
      }
    },
    {
      "path": "pages/family/create",
      "style": {
        "navigationBarTitleText": "创建家庭",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/family/detail",
      "style": {
        "navigationBarTitleText": "家庭详情",
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "backgroundTextStyle": "dark",
        "backgroundColor": "#FFFAF0"
      }
    },
    {
      "path": "pages/family/member",
      "style": {
        "navigationBarTitleText": "家庭成员",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/device/add",
      "style": {
        "navigationBarTitleText": "添加设备",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/device/control",
      "style": {
        "navigationBarTitleText": "设备控制",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/scene/create",
      "style": {
        "navigationBarTitleText": "创建场景",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationStyle": "custom",
        "enablePullDownRefresh": false
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "智能控制",
    "navigationBarBackgroundColor": "#FFFAF0",
    "backgroundColor": "#FFFAF0",
    "backgroundColorTop": "#FFFAF0",
    "backgroundColorBottom": "#FFF8DC",
    "rpxCalcMaxDeviceWidth": 960,
    "rpxCalcBaseDeviceWidth": 375,
    "rpxCalcIncludeWidth": 750
  },
  "tabBar": {
    "color": "#8B7355",
    "selectedColor": "#8B4513",
    "borderStyle": "white",
    "backgroundColor": "#FFFAF0",
    "blurEffect": "none",
    "fontSize": "14px",
    "spacing": "3px",
    "height": "60px",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/family/detail",
        "text": "家庭"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^(?!uni-)(.*)": "@/components/$1/$1.vue"
    }
  },
  "condition": {
    "current": 0,
    "list": [
      {
        "name": "首页",
        "path": "pages/index/index",
        "query": ""
      },
      {
        "name": "登录",
        "path": "pages/login/index",
        "query": ""
      },
      {
        "name": "家庭详情",
        "path": "pages/family/detail",
        "query": ""
      }
    ]
  },
  "uniIdRouter": {}
}
